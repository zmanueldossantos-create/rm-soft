# Line endings normalised once for all, whatever tool wrote the file (editor, Python script, PowerShell).
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files are never touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
