# RM SOFT - the client's server. instalar.sh / instalar.ps1 make .env from this file (and fill the secrets).
# Never commit .env, never send it: it holds the database password and the secret of the sessions.

# --- Who this server is for (shown in the scripts' messages)
CLIENT_NAME=

# --- Database (the password is generated by the installer)
POSTGRES_USER=rmsoft
POSTGRES_PASSWORD=
POSTGRES_DB=rmsoft

# --- Secret of the sessions AND of the secrets kept in the database (generated once by the installer).
# NEVER change it afterwards: the stored secrets (email password, AI key, bot token) would become unreadable.
JWT_SECRET_KEY=

# --- Where the copies go: an external disk or a network folder, never the system disk alone
#     Linux: /srv/rmsoft-copias (or /media/...)   Windows: C:/RMSOFT/copias (or D:/...)
BACKUP_DIR=/srv/rmsoft-copias
BACKUP_KEEP_DAYS=14

# --- The port the workstations open (80: http://rmsoft.local ; another one: http://rmsoft.local:8080)
HTTP_PORT=80

# --- Windows only: the server's MachineGuid (written by instalar.ps1 - do not type it)
RMSOFT_MACHINE_ID=

# --- The supplier shown on the login screen
SUPPLIER_NAME=Rock Mayika Servicos, LDA
SUPPLIER_EMAIL=geral@rm-servicos.com
SUPPLIER_PHONE=+244939224758
SUPPLIER_WEBSITE=rm-servicos.com
APP_VERSION=1.0.0
