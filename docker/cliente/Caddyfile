# RM SOFT on the client's server: the shop's network only, plain HTTP on port 80 (http://<server name or IP>).
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
