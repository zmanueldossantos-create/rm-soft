# RM SOFT - hosted service (SaaS). Copy to .env.saas (never commit it), fill in, keep it private.

# --- The domain: every company is <subdomain>.BASE_DOMAIN, the platform is ADMIN_SUBDOMAIN.BASE_DOMAIN
BASE_DOMAIN=rmsystem.co.ao
ADMIN_SUBDOMAIN=admin
# email given to Let's Encrypt for the HTTPS certificates (expiry warnings)
ACME_EMAIL=geral@rm-servicos.com

# --- Database (choose a long password)
POSTGRES_USER=rmsoft
POSTGRES_PASSWORD=
POSTGRES_DB=rmsoft

# --- Secret of the sessions AND of the secrets kept in the database (AI key, email passwords, bot token).
# Generate once:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER change it afterwards: the stored secrets would become unreadable (they would have to be typed again).
JWT_SECRET_KEY=

# --- The supplier shown on the login screen
SUPPLIER_NAME=Rock Mayika Servicos, LDA
SUPPLIER_EMAIL=geral@rm-servicos.com
SUPPLIER_PHONE=+244939224758
SUPPLIER_WEBSITE=rm-servicos.com
APP_VERSION=1.0.0

# --- Backups: where on the server (copy them elsewhere too!), and how many days they are kept
BACKUP_DIR=/srv/rmsoft-backups
BACKUP_KEEP_DAYS=14
